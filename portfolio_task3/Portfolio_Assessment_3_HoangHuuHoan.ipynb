    "def classification_metrics(truth,prediction):\n",
    "    return {'test_accuracy':float(accuracy_score(truth,prediction)),\n",
    "            'test_weighted_f1':float(f1_score(truth,prediction,average='weighted')),\n",
    "            'balanced_accuracy':float(balanced_accuracy_score(truth,prediction)),\n",
    "            'macro_f1':float(f1_score(truth,prediction,average='macro')),\n",
    "            'unstable_recall':float(recall_score(truth,prediction,pos_label=1))}\n",
    "predictions = pd.DataFrame({'row_index':test_idx,'truth':y_test.to_numpy()})\n",
    "master_rows, reports, matrices = [], {}, {}\n",
    "probabilities, test_pred = {}, {}\n",
    "for name in ['RF','MLP','ANN-1','ANN-2']:\n",
    "    if name in final_traditional:\n",
    "        probs=final_traditional[name].predict_proba(X_test)\n",
    "        pred=final_traditional[name].predict(X_test)\n",
    "        loss='not applicable'\n",
    "        cv_values=cv_summary.set_index('model').loc[name].to_dict()\n",
    "        settings=('300 trees; seed 42' if name=='RF' else '64/32/16; Adam 0.001; max_iter 500; batch auto')\n",
    "        model_type='Traditional ML'\n",
    "    else:\n",
    "        batch=frozen['ann'][name]['batch_size']\n",
    "        probs=final_anns[name](X_test_scaled.astype('float32'),training=False).numpy()\n",
    "        pred=np.argmax(probs,axis=1)\n",
    "        loss,keras_accuracy=final_anns[name].evaluate(ann_dataset(X_test_scaled,y_test,batch),verbose=0)\n",
    "        assert abs(keras_accuracy-accuracy_score(y_test,pred))<1e-6\n",
    "        assert abs(loss-log_loss(y_test,probs,labels=[0,1]))<1e-5\n",
    "        cv_values={key:'not performed' for key in ['cv_accuracy_mean','cv_accuracy_sd','cv_weighted_f1_mean','cv_weighted_f1_sd']}\n",
    "        settings=f'64/32/16; dropout 0.2 twice; batch {batch}; epochs {selected_epochs[batch]}; Adam 0.001'\n",
    "        model_type='Deep Learning'\n",
    "    probabilities[name]=probs\n",
    "    test_pred[name]=pred\n",
    "    predictions[name+'_prediction']=pred\n",
    "    predictions[name+'_p_stable']=probs[:,0]\n",
    "    predictions[name+'_p_unstable']=probs[:,1]\n",
    "    assert np.isfinite(probs).all() and np.allclose(probs.sum(axis=1),1,atol=1e-6)\n",
    "    metrics=classification_metrics(y_test,pred)\n",
    "    cm=confusion_matrix(y_test,pred,labels=[0,1])\n",
    "    matrices[name]=cm.tolist()\n",
    "    master_rows.append({'model_type':model_type,'model':name,**metrics,'test_crossentropy_loss':loss,\n",
    "                        **cv_values,'unstable_as_stable':int(cm[1,0]),'training_settings':settings})\n",
    "    print(name, '\\n',classification_report(y_test,pred,labels=[0,1],target_names=CLASS_NAMES,digits=4,zero_division=0))\n",
    "    reports[name]=classification_report(y_test,pred,labels=[0,1],target_names=CLASS_NAMES,output_dict=True,zero_division=0)\n",
    "master=pd.DataFrame(master_rows)\n",
    "show_table(master,'master_results.csv')\n",
    "predictions.to_csv(ROOT / 'results/test_predictions.csv',index=False)\n",
    "save_json(ROOT / 'results/classification_reports.json',reports)\n",
    "save_json(ROOT / 'results/confusion_matrices.json',matrices)\n",
    "fig,ax=plt.subplots(figsize=(9,4.8))\n",
    "bars=ax.bar(master.model,master.test_accuracy*100,color=['#167d9a','#4066b0','#df8533','#b45d32'])\n",
    "ax.bar_label(bars,labels=[f'{v:.2%}' for v in master.test_accuracy],padding=4)\n",
    "ax.axhline(63.8,color='grey',ls='--',label='Majority-only baseline: 63.8%')\n",
    "ax.set(ylim=(0,105),ylabel='Test accuracy (%)',xlabel='Frozen final configuration',\n",
    "       title='Four core models - shared 3,000-row benchmark test split')\n",
    "ax.legend(loc='lower right')\n",
    "save_figure('final_accuracy_comparison.png')\n",
    "fig,axes=plt.subplots(2,2,figsize=(9,8),constrained_layout=True)\n",
    "for ax,name in zip(axes.flat,['RF','MLP','ANN-1','ANN-2']):\n",
    "    ConfusionMatrixDisplay(np.array(matrices[name]),display_labels=CLASS_NAMES).plot(\n",
    "        ax=ax,cmap='Blues',colorbar=False,values_format='d')\n",
    "    ax.set_title(f'{name}: final refit')\n",
    "save_figure('final_confusion_matrices.png')\n",
    "best_observed=master.sort_values('test_accuracy',ascending=False).iloc[0]\n",
    "best_trad_test=master[master.model.isin(['RF','MLP'])].sort_values('test_accuracy',ascending=False).iloc[0]\n",
    "best_ann_test=master[master.model.isin(['ANN-1','ANN-2'])].sort_values('test_accuracy',ascending=False).iloc[0]\n",
    "explain(f'**Observed test ranking:** {best_observed[\"model\"]} has the highest accuracy '\n",
