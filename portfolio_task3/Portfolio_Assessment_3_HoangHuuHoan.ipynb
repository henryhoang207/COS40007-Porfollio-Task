    "# Explicit tf.data options bound background CPU threads and preserve deterministic order.\n",
    "def ann_dataset(xx, yy, batch_size, training=False):\n",
    "    ds = tf.data.Dataset.from_tensor_slices((np.asarray(xx,dtype='float32'),np.asarray(yy,dtype='int64')))\n",
    "    if training:\n",
    "        ds = ds.shuffle(len(xx),seed=SEED,reshuffle_each_iteration=True)\n",
    "    ds = ds.batch(batch_size)\n",
    "    options = tf.data.Options()\n",
    "    options.experimental_deterministic = True\n",
    "    options.threading.private_threadpool_size = 2\n",
    "    options.threading.max_intra_op_parallelism = 2\n",
    "    return ds.with_options(options).prefetch(1)\n",
    "def train_trial(batch, max_epochs):\n",
    "    model = build_ann()\n",
    "    reduce_lr = keras.callbacks.ReduceLROnPlateau(monitor='val_loss',factor=.5,patience=5,\n",
    "                                                min_delta=0.0,min_lr=1e-6,verbose=0)\n",
    "    early = keras.callbacks.EarlyStopping(monitor='val_loss',patience=10,\n",
    "                                          min_delta=0.0,restore_best_weights=True)\n",
    "    recorder = keras.callbacks.LambdaCallback(on_epoch_end=lambda epoch,logs:\n",
    "        logs.update({'lr_after_epoch':float(keras.backend.get_value(model.optimizer.learning_rate))}))\n",
    "    started = time.perf_counter()\n",
    "    history = model.fit(ann_dataset(X_fit_scaled,y_fit,batch,True),\n",
    "                        validation_data=ann_dataset(X_val_scaled,y_val,batch),\n",
    "                        epochs=max_epochs,callbacks=[reduce_lr,early,recorder],verbose=0).history\n",
    "    history = {k:list(map(float,v)) for k,v in history.items()}\n",
    "    best_epoch = int(np.argmin(history['val_loss'])+1)\n",
    "    val_loss,val_accuracy = model.evaluate(ann_dataset(X_val_scaled,y_val,batch),verbose=0)\n",
    "    np.testing.assert_allclose(val_loss,min(history['val_loss']),atol=1e-5,rtol=1e-5)\n",
    "    row = {'batch_size':batch,'max_epochs':max_epochs,'actual_epochs':len(history['loss']),\n",
    "           'best_epoch':best_epoch,'best_validation_loss':float(val_loss),\n",
    "           'validation_accuracy_at_best_loss':float(val_accuracy),\n",
    "           'initial_learning_rate':.001,'minimum_learning_rate':min(history['lr_after_epoch']),\n",
    "           'fit_seconds':time.perf_counter()-started}\n",
    "    return history,row\n",
    "ann_example = build_ann()\n",
    "ann_example.summary()\n",
    "pilot_history,pilot_row = train_trial(32,10)\n",
    "with (ROOT / 'results/ann_pilot_history.pkl').open('wb') as f:\n",
    "    pickle.dump(pilot_history,f)\n",
    "save_json(ROOT / 'results/ann_pilot_results.json',pilot_row)\n",
    "print('10-epoch pilot:',pilot_row,flush=True)\n",
    "trial_histories, ann_rows = {}, []\n",
    "for batch in [16,32,64]:\n",
    "    history,row = train_trial(batch,50)\n",
    "    trial_histories[batch] = history\n",
    "    ann_rows.append(row)\n",
    "    with (ROOT / f'results/ann_batch{batch}_development_history.pkl').open('wb') as f:\n",
    "        pickle.dump(history,f)\n",
    "    print('Development trial:',row,flush=True)\n",
    "ann_development = pd.DataFrame(ann_rows)\n",
    "show_table(ann_development,'ann_development_results.csv')\n",
    "selected_epochs = {batch:int(ann_development.set_index('batch_size').loc[batch,'best_epoch']) for batch in [32,64]}\n",
    "assert all(1<=e<=50 for e in selected_epochs.values())\n",
    "assert all(len(h['loss'])<=50 and len(h['val_loss'])==len(h['loss']) for h in trial_histories.values())\n",
    "assert all(np.isfinite(v).all() for h in trial_histories.values() for v in h.values())\n",
    "for metric,ylabel in [('loss','Sparse categorical crossentropy'),('accuracy','Accuracy')]:\n",
    "    fig,axes = plt.subplots(1,3,figsize=(14,4),sharey=True,constrained_layout=True)\n",
    "    for ax,batch in zip(axes,[16,32,64]):\n",
    "        history=trial_histories[batch]\n",
    "        epochs=np.arange(1,len(history[metric])+1)\n",
    "        ax.plot(epochs,history[metric],label='Fit (dropout active)')\n",
    "        ax.plot(epochs,history['val_'+metric],label='Validation (dropout off)')\n",
    "        best=int(ann_development.set_index('batch_size').loc[batch,'best_epoch'])\n",
    "        ax.axvline(best,color='grey',ls='--',label=f'Best loss epoch {best}')\n",
    "        ax.set(title=f'Batch {batch}',xlabel='Epoch',ylabel=ylabel)\n",
    "    axes[0].legend(fontsize=8)\n",
    "    fig.suptitle(f'ANN development trial {metric} curves - not final-refit test results')\n",
    "    save_figure(f'ann_development_{metric}.png')\n",
    "fig,ax=plt.subplots(figsize=(8,4))\n",
    "for batch in [16,32,64]:\n",
    "    history=trial_histories[batch]\n",
    "    ax.step(range(1,len(history['lr_after_epoch'])+1),history['lr_after_epoch'],where='post',label=f'Batch {batch}')\n",
    "ax.set(xlabel='Epoch',ylabel='Learning rate after epoch',title='Development LR schedules')\n",
    "ax.legend()\n",
    "save_figure('ann_development_learning_rate.png')\n",
    "best_batch=int(ann_development.sort_values('best_validation_loss').iloc[0].batch_size)\n",
    "explain(f'**Development interpretation:** batch {best_batch} has the lowest observed validation loss. '\n",
    "        f'The frozen core settings remain ANN-1 batch 32 ({selected_epochs[32]} epochs) and '\n",
    "        f'ANN-2 batch 64 ({selected_epochs[64]} epochs). Batch 16 is retained as a development '\n",
    "        'experiment only. Validation accuracy is reported at the epoch with minimum validation loss, '\n",
    "        'rather than the highest-accuracy epoch. Dropout makes fit and validation curves use different '\n",
    "        'conditions, so validation accuracy can exceed fit accuracy. Single-seed batch differences '\n",
    "        'do not establish a universal best batch size.')\n",
    "save_json(ROOT / 'results/ann_development_verification.json',{\n",
    "    'pilot_epochs':10,'trial_batches':[16,32,64],'maximum_epochs':50,\n",
    "    'early_stopping_patience':10,'restored_best_weights_checked':True,\n",
    "    'reduce_lr_patience':5,'reduce_lr_factor':.5,'initial_lr':.001,\n",
    "    'selected_core_epochs':{str(k):v for k,v in selected_epochs.items()},\n",
    "    'test_used_for_selection':False,'histories_complete_and_finite':True,\n",
    "})\n",
    "print('PHASE 4 PASSED: pilot, three fresh trials, restored best validation losses, histories and curves.')"
   ]
