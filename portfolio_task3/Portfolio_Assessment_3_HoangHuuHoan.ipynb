    "import joblib\n",
    "for name,filename in [('RF','random_forest.pkl'),('MLP','mlp_classifier.pkl')]:\n",
    "    joblib.dump(final_traditional[name],ROOT / 'models' / filename,compress=3)\n",
    "joblib.dump(common_scaler,ROOT / 'models/standard_scaler.pkl',compress=3)\n",
    "for name,batch in [('ANN-1',32),('ANN-2',64)]:\n",
    "    final_anns[name].save(ROOT / f'models/ann_batch{batch}.h5')\n",
    "metadata={\n",
    "    'ordered_features':FEATURES,'class_map':CLASS_MAP,\n",
    "    'class_probability_order':['stable','unstable'],\n",
    "    'decision_rule':'argmax of class probabilities; ties resolve to first class',\n",
    "    'data_sha256':data_hash,'frozen_configuration_sha256':frozen_digest,\n",
    "    'seeds':{'split_and_model':SEED,'internal_validation':VALIDATION_SEED},\n",
    "    'versions':VERSIONS,'platform':platform.platform(),'cpu_threads':2,\n",
    "    'common_scaler':'standard_scaler.pkl','common_scaler_fit_rows':7000,\n",
    "    'traditional_serialization':'joblib compressed pickle; load with joblib.load',\n",
    "    'ann_serialization':'whole-model legacy HDF5; load with keras.models.load_model',\n",
    "    'model_files':{'RF':'random_forest.pkl','MLP':'mlp_classifier.pkl',\n",
    "                   'ANN-1':'ann_batch32.h5','ANN-2':'ann_batch64.h5'},\n",
    "    'ann_saved_models':'fresh final refits, not development trial weights',\n",
    "    'ann_core_settings':frozen['ann'],'ann_architecture':frozen['ann_architecture'],\n",
    "    'ann_optimizer':'Adam','ann_initial_learning_rate':.001,'ann_final_callbacks':[],\n",
    "    'traditional_settings':frozen['traditional'],\n",
    "    'probability_reload_tolerance':{'atol':1e-6,'rtol':1e-6},\n",
    "    'test_is_previously_inspected_benchmark':True,\n",
    "}\n",
    "save_json(ROOT / 'models/model_metadata.json',metadata)\n",
    "audit=subprocess.run([sys.executable,str(ROOT / 'verify_artifacts.py')],cwd=ROOT,\n",
    "                     capture_output=True,text=True,encoding='utf-8')\n",
    "print(audit.stdout)\n",
    "if audit.returncode:\n",
    "    print(audit.stderr)\n",
    "assert audit.returncode==0,'Independent artifact audit failed'\n",
    "verification=json.loads((ROOT / 'results/artifact_verification.json').read_text())\n",
    "assert verification['passed'] and verification['fresh_process']\n",
    "manifest=[]\n",
    "for path in sorted(list((ROOT/'models').glob('*'))+list((ROOT/'results').glob('*.pkl'))):\n",
    "    assert path.stat().st_size<100_000_000,'Artifact needs a large-file workflow'\n",
    "    manifest.append({'path':path.relative_to(ROOT).as_posix(),'bytes':path.stat().st_size,\n",
    "                     'sha256':hashlib.sha256(path.read_bytes()).hexdigest()})\n",
    "save_json(ROOT / 'results/model_artifact_manifest.json',manifest)\n",
    "show_table(pd.DataFrame(manifest))\n",
    "print('PHASE 6 PASSED: four complete models, common scaler, metadata, histories and fresh-process agreement.')"
