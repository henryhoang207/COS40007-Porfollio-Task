    "frozen = {\n",
    "    'features':FEATURES,'class_map':CLASS_MAP,'data_sha256':data_hash,\n",
    "    'seed':SEED,'validation_seed':VALIDATION_SEED,'test_seed':SEED,\n",
    "    'traditional':{name:spec.get_params() for name,spec in traditional_specs.items()},\n",
    "    'best_traditional_by_development_cv':best_traditional,\n",
    "    'ann':{'ANN-1':{'batch_size':32,'epochs':selected_epochs[32]},\n",
    "           'ANN-2':{'batch_size':64,'epochs':selected_epochs[64]}},\n",
    "    'ann_architecture':[{'dense':64,'activation':'relu'},{'dropout':.2},\n",
    "                        {'dense':32,'activation':'relu'},{'dropout':.2},\n",
    "                        {'dense':16,'activation':'relu'},{'dense':2,'activation':'softmax'}],\n",
    "    'ann_optimizer':'Adam','ann_initial_learning_rate':.001,\n",
    "    'ann_loss':'sparse_categorical_crossentropy','decision_rule':'argmax of class probabilities',\n",
    "    'final_refit':{'rows':7000,'common_scaler_fit_on':'development only',\n",
    "                   'fresh_initialization':True,'ann_callbacks':[], 'ann_learning_rate':'constant 0.001'},\n",
    "    'frozen_before_task3_test_predictions':True,'test_is_previously_inspected_benchmark':True,\n",
    "}\n",
    "save_json(ROOT / 'results/frozen_configurations.json',frozen)\n",
    "frozen_digest = hashlib.sha256((ROOT / 'results/frozen_configurations.json').read_bytes()).hexdigest()\n",
    "print('Frozen configuration SHA-256:',frozen_digest)\n",
    "common_scaler = StandardScaler().fit(X_dev)\n",
    "X_dev_scaled = common_scaler.transform(X_dev)\n",
    "X_test_scaled = common_scaler.transform(X_test)\n",
    "assert common_scaler.n_samples_seen_ == 7000\n",
    "np.testing.assert_allclose(common_scaler.mean_,X_dev.mean().to_numpy(),atol=1e-12)\n",
    "final_traditional, final_anns, final_histories, final_fit_rows = {}, {}, {}, []\n",
    "final_warnings=[]\n",
    "for name,spec in traditional_specs.items():\n",
    "    started=time.perf_counter()\n",
    "    estimator=clone(spec)\n",
    "    with warnings.catch_warnings(record=True) as caught:\n",
    "        warnings.simplefilter('always',ConvergenceWarning)\n",
    "        estimator.fit(X_dev_scaled,y_dev)\n",
    "    for w in caught:\n",
    "        final_warnings.append({'model':name,'category':w.category.__name__,'message':str(w.message)})\n",
    "    final_traditional[name]=Pipeline([('scale',copy.deepcopy(common_scaler)),('model',estimator)])\n",
    "    final_fit_rows.append({'model':name,'fit_seconds':time.perf_counter()-started,\n",
    "                           'iterations_or_epochs':getattr(estimator,'n_iter_',None),\n",
    "                           'batch_size':str(getattr(estimator,'batch_size','not applicable'))})\n",
    "for name,batch in [('ANN-1',32),('ANN-2',64)]:\n",
    "    model=build_ann()\n",
    "    started=time.perf_counter()\n",
    "    history=model.fit(ann_dataset(X_dev_scaled,y_dev,batch,True),epochs=selected_epochs[batch],verbose=0).history\n",
    "    history={k:list(map(float,v)) for k,v in history.items()}\n",
    "    final_anns[name]=model\n",
    "    final_histories[batch]=history\n",
    "    final_fit_rows.append({'model':name,'fit_seconds':time.perf_counter()-started,\n",
    "                           'iterations_or_epochs':len(history['loss']),'batch_size':str(batch)})\n",
    "    with (ROOT / f'results/ann_batch{batch}_final_history.pkl').open('wb') as f:\n",
    "        pickle.dump(history,f)\n",
    "save_json(ROOT / 'results/final_fit_warnings.json',final_warnings)\n",
    "show_table(pd.DataFrame(final_fit_rows),'final_fit_diagnostics.csv')\n",
    "if final_warnings:\n",
    "    display(pd.DataFrame(final_warnings))\n",
    "assert not any(w['category']=='ConvergenceWarning' for w in final_warnings)\n",
    "assert hashlib.sha256((ROOT / 'results/frozen_configurations.json').read_bytes()).hexdigest()==frozen_digest\n",
    "print('Final refits complete. Test metrics are calculated in the next cell.')"
   ]
